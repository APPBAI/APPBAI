# Google Form Integration Configuration
# 1. Create a Google Form with an Email field.
# 2. Get the formResponse URL (e.g., https://docs.google.com/forms/d/e/xxx/formResponse)
# 3. Get the entry ID for the email field (e.g., entry.123456789)

GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/REPLACE_WITH_YOUR_FORM_ID/formResponse"
GOOGLE_FORM_EMAIL_ENTRY_ID="entry.REPLACE_WITH_YOUR_FIELD_ID"
